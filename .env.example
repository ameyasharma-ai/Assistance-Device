# ==============================================================================
# Wearable AI Reading Assistant — Environment Configuration Template
# Copy this file to .env and insert your free Google Gemini API key.
# ==============================================================================

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier
# Default: gemini-flash-lite-latest (fastest, lightweight multimodal vision model)
GEMINI_MODEL=gemini-flash-lite-latest

# System Prompt Version
AI_PROMPT_VERSION=2.1.0
